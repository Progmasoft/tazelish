load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "tazelish_library",
    srcs = [
        "Sources/CommandLine.cpp",
        "Sources/Help.cpp",
        "Sources/Version.cpp",
        "Sources/VersionFiles.cpp",
    ],
    hdrs = glob(["Headers/Progmasoft/Tazelish/*.hpp"]),
    includes = ["Headers"],
    visibility = ["//Tests:__pkg__"],
    deps = ["@fmt"],
)

cc_binary(
    name = "tazelish",
    srcs = ["Sources/Main.cpp"],
    deps = [":tazelish_library"],
)
